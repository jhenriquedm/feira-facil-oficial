rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Common helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Users Collection & Cascading Subcollections
    match /users/{userId} {
      // Allow reading user profile (for auth check, recovery and unique checks)
      allow read: if true;
      // Allow user to create/update/delete their own profile
      allow write: if isOwner(userId);

      // User Subcollection: Categories (Cascading per-user folder)
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }

      // User Subcollection: Products (Cascading per-user folder)
      match /products/{productId} {
        allow read, write: if isOwner(userId);
      }

      // User Subcollection: Purchases (Cascading per-user folder)
      match /purchases/{purchaseId} {
        allow read, write: if isOwner(userId);

        // Nested Items Subcollection
        match /items/{itemId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // 2. Legacy Flat Collections (Maintained for backward compatibility)
    match /categories/{categoryId} {
      allow list, get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update, delete: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /products/{productId} {
      allow list, get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update, delete: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /purchases/{purchaseId} {
      allow list, get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update, delete: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      match /items/{itemId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
