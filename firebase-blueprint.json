{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Category for organizing products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 50 },
        "iconName": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "iconName", "isActive", "createdAt", "updatedAt", "userId"]
    },
    "Product": {
      "title": "Product",
      "description": "Registered product available in catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "categoryId": { "type": "string" },
        "unit": { "type": "string" },
        "brand": { "type": "string", "maxLength": 50 },
        "barcode": { "type": "string" },
        "lastPrice": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "categoryId", "unit", "lastPrice", "isActive", "createdAt", "updatedAt", "userId"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Shopping list or completed purchase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "market": { "type": "string", "maxLength": 100 },
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["monthly", "weekly", "emergency", "butcher", "pharmacy", "other"] },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["inProgress", "completed"] },
        "total": { "type": "number" },
        "budget": { "type": "number" },
        "discount": { "type": "number" },
        "additionalFee": { "type": "number" },
        "itemsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "market", "date", "type", "status", "total", "createdAt", "updatedAt", "userId"]
    },
    "PurchaseItem": {
      "title": "PurchaseItem",
      "description": "An item belonging to a shopping list / purchase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "purchaseId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string", "maxLength": 100 },
        "productBrand": { "type": "string", "maxLength": 50 },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "unit": { "type": "string" },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "isChecked": { "type": "boolean" },
        "barcode": { "type": "string" }
      },
      "required": ["id", "purchaseId", "productId", "productName", "productBrand", "categoryId", "categoryName", "unit", "quantity", "unitPrice", "isChecked"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with optional contact details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string" },
        "cpf": { "type": "string" },
        "phone": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "The user profile configuration data"
    },
    "users/{userId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Categories owned by the specific user"
    },
    "users/{userId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catalog of products owned by the specific user"
    },
    "users/{userId}/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Shopping lists and purchases owned by the specific user"
    },
    "users/{userId}/purchases/{purchaseId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/PurchaseItem" },
      "description": "Items of a specific purchase"
    },
    "categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Legacy categories for backward compatibility migration"
    },
    "products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Legacy products for backward compatibility migration"
    },
    "purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Legacy purchases for backward compatibility migration"
    }
  }
}
